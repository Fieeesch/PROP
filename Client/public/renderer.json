  {
    "name": "Laser Wave Renderer",
    "strategyId": "laser-wave",
    "capabilities": {
      "preview": {
        "maxBounces": 0
      },
      "objects": {
        "LaserSimulationSettings": {
          "label": "Simulationseinstellungen",
          "deletable": false,
          "required": ["width", "height", "wallFactor", "lensFactor", "lensSupersampleFactor", "sensorFactor", "sensorSupersampleFactor", "fftZeroPaddingFactor", "planeWidthMm", "planeHeightMm", "baseSeed"],
          "defaults": {
            "width": 216,
            "height": 216,
            "wallFactor": 2,
            "lensFactor": 1,
            "lensSupersampleFactor": 2,
            "sensorFactor": 1,
            "sensorSupersampleFactor": 2,
            "fftZeroPaddingFactor": 4,
            "planeWidthMm": 5.12,
            "planeHeightMm": 5.12,
            "baseSeed": 42069
          },
          "minInstances": 1,
          "maxInstances": 1,
          "validation": {
            "width": {
              "label": "Basisauflösung – Breite",
              "description": "Anzahl horizontaler Basissamples. Ändert nur Auflösung, Rechenzeit und Speicherbedarf, nicht die physische Größe von Wand, Linse oder Sensor.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "height": {
              "label": "Basisauflösung – Höhe",
              "description": "Anzahl vertikaler Basissamples. Ändert nur Auflösung, Rechenzeit und Speicherbedarf, nicht die physische Größe von Wand, Linse oder Sensor.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "wallFactor": {
              "label": "Wand-Auflösungsfaktor",
              "description": "Multipliziert die Basissamples für das Wandfeld. Ein höherer Wert tastet dieselbe physische Wandfläche feiner ab, benötigt aber mehr Speicher und Rechenzeit.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "lensFactor": {
              "label": "Linsen-Auflösungsfaktor",
              "description": "Multipliziert die Rasterauflösung der Linse, ohne ihren Aperturdurchmesser zu verändern. Höhere Werte erhöhen Genauigkeit und Ressourcenbedarf.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "lensSupersampleFactor": {
              "label": "Linsen-Supersampling",
              "description": "Zusätzliche interne Überabtastung des Linsenfelds. Reduziert Abtastartefakte, vergrößert aber die benötigten Puffer.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "sensorFactor": {
              "label": "Sensor-Ausgabefaktor",
              "description": "Multipliziert Breite und Höhe des ausgegebenen Sensorbilds. Die physische Sensorgröße bleibt unverändert.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "sensorSupersampleFactor": {
              "label": "Sensor-Supersampling",
              "description": "Berechnet intern mehrere Samples pro Ausgabepixel und mittelt sie. Verbessert die Bildqualität, erhöht aber Speicherbedarf und Rechenzeit deutlich.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "fftZeroPaddingFactor": {
              "label": "FFT-Zero-Padding",
              "description": "Vergrößert die FFT-Arbeitsflächen mit Nullen. Das reduziert periodische Randartefakte, kann den GPU-Speicherbedarf jedoch stark erhöhen.",
              "gpuMemorySensitive": true,
              "type": "integer",
              "min": 1
            },
            "planeWidthMm": {
              "label": "Simulationsfenster – Breite (mm)",
              "description": "Physische Breite des berechneten Wandfelds. Sie bestimmt zusammen mit der Rasterauflösung den horizontalen Sampleabstand und kann deshalb das Ergebnis beeinflussen.",
              "type": "number",
              "min": 0.001
            },
            "planeHeightMm": {
              "label": "Simulationsfenster – Höhe (mm)",
              "description": "Physische Höhe des berechneten Wandfelds. Sie bestimmt zusammen mit der Rasterauflösung den vertikalen Sampleabstand und kann deshalb das Ergebnis beeinflussen.",
              "type": "number",
              "min": 0.001
            },
            "baseSeed": {
              "label": "Zufalls-Seed der Wand",
              "description": "Startwert für die zufällige Rauheitsstruktur. Derselbe Seed erzeugt bei gleicher Konfiguration dieselbe Wandstruktur.",
              "type": "integer",
              "min": 0
            }
          },
          "previewSupported": true
        },
        "Laser": {
          "label": "Laser",
          "deletable": false,
          "required": ["on", "center", "radiusMm", "wavelengthNm", "amplitudeVm"],
          "hiddenProperties": ["azimuthDeg", "elevationDeg", "direction"],
          "defaults": {
            "on": true,
            "center": [128, 128, 0],
            "radiusMm": 1,
            "wavelengthNm": 650,
            "amplitudeVm": 500
          },
          "minInstances": 1,
          "maxInstances": 1,
          "validation": {
            "on": {
              "label": "Laser eingeschaltet",
              "description": "Schaltet den Laserstrahl ein oder aus. Das entspricht dem Schalter am Laserpointer in der 3D-Szene.",
              "type": "boolean"
            },
            "center": {
              "label": "Laserposition (mm)",
              "description": "Position der Strahlquelle. X und Y verschieben den Auftreffpunkt auf der Wand; Z verschiebt den Laser entlang der optischen Achse.",
              "type": "vector3"
            },
            "radiusMm": {
              "label": "Strahlradius (mm)",
              "description": "Radius des gaußförmigen Laserstrahls. Bei diesem Abstand zur Strahlachse ist die Intensität auf etwa 1/e² ihres Maximums gefallen.",
              "type": "number",
              "min": 0.001
            },
            "wavelengthNm": {
              "label": "Wellenlänge (nm)",
              "description": "Wellenlänge des Lasers. Sie bestimmt die sichtbare Farbe und beeinflusst Beugung sowie Interferenz.",
              "type": "number",
              "min": 380,
              "max": 780
            },
            "amplitudeVm": {
              "label": "Feldamplitude (V/m)",
              "description": "Maximale elektrische Feldstärke des einfallenden Laserstrahls. Ein größerer Wert erhöht die Intensität des berechneten Bildes.",
              "type": "number",
              "min": 0
            }
          },
          "previewSupported": true
        },
        "DiffuseWall": {
          "label": "Wand",
          "deletable": false,
          "required": ["center", "normal", "widthMm", "heightMm", "correlationLengthMm", "albedo"],
          "hiddenProperties": ["rmsRoughnessMm"],
          "defaults": {
            "center": [128, 128, 256],
            "normal": [0, 0, -1],
            "widthMm": 11,
            "heightMm": 11,
            "correlationLengthMm": 0.04,
            "albedo": 1
          },
          "minInstances": 1,
          "maxInstances": 1,
          "validation": {
            "center": {
              "label": "Wandposition (mm)",
              "description": "Mittelpunkt der Wand. X und Y sind auf der optischen Achse fixiert; Z bestimmt den Abstand zum Laser.",
              "type": "vector3",
              "lockedComponents": ["x", "y"]
            },
            "normal": {
              "label": "Wandnormale",
              "description": "Richtung, in welche die Vorderseite der Wand zeigt. Sie ist für diesen optischen Aufbau fest vorgegeben.",
              "type": "vector3",
              "nonZero": true,
              "lockedComponents": ["x", "y", "z"]
            },
            "widthMm": {
              "label": "Wandbreite (mm)",
              "description": "Sichtbare Breite der Wand in der 3D-Szene. Dieser Wert verändert weder das Simulationsfenster noch das berechnete Sensorbild.",
              "type": "number",
              "min": 0.001
            },
            "heightMm": {
              "label": "Wandhöhe (mm)",
              "description": "Sichtbare Höhe der Wand in der 3D-Szene. Dieser Wert verändert weder das Simulationsfenster noch das berechnete Sensorbild.",
              "type": "number",
              "min": 0.001
            },
            "correlationLengthMm": {
              "label": "Rauheits-Korrelationslänge (mm)",
              "description": "Typische seitliche Größe zusammenhängender Unebenheiten der Wand. Kleine Werte erzeugen eine feinere, große Werte eine gröbere Oberflächenstruktur.",
              "type": "number",
              "min": 0.001
            },
            "albedo": {
              "label": "Reflexionsgrad",
              "description": "Anteil der einfallenden Leistung, den die Wand reflektiert. 0 bedeutet vollständige Absorption, 1 ideale Reflexion.",
              "type": "number",
              "min": 0,
              "max": 1
            }
          },
          "previewSupported": true
        },
        "Lens": {
          "label": "Linse",
          "deletable": false,
          "required": ["center", "focalLengthMm", "apertureRadiusMm", "transmission"],
          "hiddenProperties": ["normal"],
          "defaults": {
            "center": [128, 128, -128],
            "focalLengthMm": 128,
            "apertureRadiusMm": 2.56,
            "transmission": 1
          },
          "minInstances": 1,
          "maxInstances": 1,
          "validation": {
            "center": {
              "label": "Linsenposition (mm)",
              "description": "Mittelpunkt der Linse. X und Y sind auf der optischen Achse fixiert; Z bestimmt ihre Position zwischen Wand und Sensor.",
              "type": "vector3",
              "lockedComponents": ["x", "y"]
            },
            "focalLengthMm": {
              "label": "Brennweite (mm)",
              "description": "Brennweite der dünnen Linse. Sie bestimmt zusammen mit Wand- und Linsenabstand die optimale Sensorposition.",
              "type": "number",
              "min": 0.001
            },
            "apertureRadiusMm": {
              "label": "Aperturradius (mm)",
              "description": "Radius der wirksamen Linsenöffnung. Eine größere Öffnung lässt mehr Licht durch und verändert das Beugungsbild.",
              "type": "number",
              "min": 0.001
            },
            "transmission": {
              "label": "Amplitudentransmission",
              "description": "Faktor zwischen 0 und 1, mit dem die Linse die elektrische Feldamplitude überträgt. Die übertragene Intensität skaliert mit dem Quadrat dieses Werts.",
              "type": "number",
              "min": 0,
              "max": 1
            }
          },
          "previewSupported": true
        },
        "Sensor": {
          "label": "Sensor",
          "deletable": false,
          "mustBeBehind": {
            "referenceObjectType": "Lens",
            "normalObjectType": "DiffuseWall",
            "minimumDistanceMm": 20
          },

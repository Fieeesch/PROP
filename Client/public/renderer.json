[
  {
    "name": "2D Renderer",
    "baseUrl": "/2Dprism-api",
    "strategyId": "prism-ray",
    "capabilities": {
      "preview": {
        "maxBounces": 3
      },
      "objects": {
        "RenderSettings": {
          "label": "Render Settings",
          "required": ["recursionDepth", "lambdaMin", "lambdaMax", "spectrumBins", "lightPower", "lightSamples", "imageExposure", "imageWidth", "imageHeight", "rngSeedEnabled", "rngSeed"],
          "defaults": {
            "recursionDepth": 4,
            "lambdaMin": 0.38,
            "lambdaMax": 0.78,
            "spectrumBins": 81,
            "lightPower": 200,
            "lightSamples": 16777216,
            "imageExposure": 100,
            "imageWidth": 512,
            "imageHeight": 512,
            "rngSeedEnabled": false,
            "rngSeed": 1
          },
          "maxInstances": 1,
          "minInstances": 1,
          "validation": {
            "recursionDepth": { "type": "integer", "min": 1 },
            "lambdaMin": { "type": "number", "min": 0, "lessThan": "lambdaMax" },
            "lambdaMax": { "type": "number", "min": 0 },
            "spectrumBins": { "type": "integer", "min": 2 },
            "lightPower": { "type": "number", "min": 0 },
            "lightSamples": { "type": "integer", "min": 1 },
            "imageExposure": { "type": "number", "min": 0 },
            "imageWidth": { "type": "integer", "min": 1 },
            "imageHeight": { "type": "integer", "min": 1 },
            "rngSeedEnabled": { "type": "boolean" },
            "rngSeed": { "type": "integer", "min": 0, "max": 4294967295 }
          },
          "previewSupported": true
        },
        "ImagePlane": {
          "label": "Image Plane",
          "required": ["point", "normal", "right", "up", "width", "height"],
          "defaults": {
            "point": [1.808, -0.97, 0],
            "normal": [-1, 0, 0],
            "right": [0, 0, 1],
            "up": [0, 1, 0],
            "width": 0.1,
            "height": 0.1
          },
          "maxInstances": 1,
          "minInstances": 1,
          "validation": {
            "point": { "type": "vector3" },
            "normal": { "type": "vector3", "nonZero": true },
            "right": { "type": "vector3", "nonZero": true },
            "up": { "type": "vector3", "nonZero": true },
            "width": { "type": "number", "min": 0.001 },
            "height": { "type": "number", "min": 0.001 }
          },
          "previewSupported": true
        },
        "CircleLight": {
          "label": "Circle Light",
          "required": ["spdPreset", "center", "direction", "right", "up", "radius"],
          "defaults": {
            "type": "circle",
            "spdPreset": "d65",
            "center": [-1.808, -1, 0],
            "direction": [0.94, 0.342, 0],
            "right": [0, 0, -1],
            "up": [-0.342, 0.94, 0],
            "radius": 0.01
          },
          "maxInstances": 1,
          "exclusiveWith": ["AreaLight"],
          "validation": {
            "type": { "type": "string", "options": ["circle"] },
            "spdPreset": { "type": "string", "options": ["d65", "uniform", "tungsten", "leds", "fluorescent", "highPressureSodium", "custom"] },
            "center": { "type": "vector3" },
            "direction": { "type": "vector3", "nonZero": true },
            "right": { "type": "vector3", "nonZero": true },
            "up": { "type": "vector3", "nonZero": true },
            "radius": { "type": "number", "min": 0.001 }
          },
          "previewSupported": true
        },
        "AreaLight": {
          "label": "Area Light",
          "required": ["spdPreset","center", "direction", "right", "up", "width", "height"],
          "defaults": {
            "type": "area",
            "spdPreset": "d65",
            "center": [-1.808, -1.0, 0],
            "direction": [0.94, 0.342, 0],
            "right": [0, 0, -1],
            "up": [-0.342, 0.94, 0],
            "width": 0.02,
            "height": 0.01
          },
          "maxInstances": 1,
          "exclusiveWith": ["CircleLight"],
          "validation": {
            "type": { "type": "string", "options": ["area"] },
            "spdPreset": { "type": "string", "options": ["d65", "uniform", "tungsten", "leds", "fluorescent", "highPressureSodium", "custom"] },
            "center": { "type": "vector3" },
            "direction": { "type": "vector3", "nonZero": true },
            "right": { "type": "vector3", "nonZero": true },
            "up": { "type": "vector3", "nonZero": true },
            "width": { "type": "number", "min": 0.001 },
            "height": { "type": "number", "min": 0.001 }
          },
          "previewSupported": true
        },
        "Prism": {
          "label": "Prism",
          "required": ["position", "prismAngleDeg", "rotationDeg", "radius", "zDepth", "material"],
          "defaults": {
            "position": [0, 0],
            "prismAngleDeg": 60,
            "rotationDeg": 0,
            "radius": 1,
            "zDepth": 1,
            "material": "bk7"
          },
          "maxInstances": 1,
          "minInstances": 1,
          "validation": {
            "position": { "type": "vector2" },
            "prismAngleDeg": { "type": "number", "min": 0.001, "max": 179.999 },
            "rotationDeg": { "type": "number" },
            "radius": { "type": "number", "min": 0.001 },
            "zDepth": { "type": "number", "min": 0.001 },
            "material": { "type": "string", "options": ["bk7", "sf57", "fk51a", "lak34"] }
          },
          "previewSupported": true
        }
      }
    }
  },
  {

            "fuzz": { "type": "number", "min": 0, "max": 1 },
            "ior": { "type": "number", "min": 0.001 },
            "dispersive": { "type": "boolean" },
            "dispersionA": { "type": "number", "min": 0.001 },
            "dispersionB": { "type": "number" },
            "dispersionC": { "type": "number" },
            "absorptionDensity": { "type": "number", "min": 0 },
            "absorptionColor": { "type": "vector3" },
            "absorptionProfile": { "type": "string", "options": ["constant", "green-filter", "red-filter", "d65-white", "warm-blackbody", "cornell-white", "cornell-green", "cornell-red", "cornell-light", "rgb"] },
            "emission": { "type": "vector3" },
            "emissionProfile": { "type": "string", "options": ["d65-white", "warm-blackbody", "cornell-light", "rgb", "constant", "green-filter", "red-filter", "cornell-white", "cornell-green", "cornell-red"] },
            "spectralProfile": { "type": "string", "options": ["rgb", "constant", "green-filter", "red-filter", "d65-white", "warm-blackbody", "cornell-white", "cornell-green", "cornell-red", "cornell-light"] }
